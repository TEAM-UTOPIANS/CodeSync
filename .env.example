FLASK_ENV=production
SECRET_KEY=change-me

# Server
HOST=0.0.0.0
PORT=5000

# Judge0
# Option A: RapidAPI-hosted Judge0 (recommended if you already have RapidAPI)
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_KEY=your-rapidapi-key
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# Option B: Self-hosted Judge0 (Docker) base URL example:
# JUDGE0_BASE_URL=http://localhost:2358
# JUDGE0_RAPIDAPI_KEY=
# JUDGE0_RAPIDAPI_HOST=

# Redis (optional; enables multi-instance scaling)
REDIS_URL=redis://localhost:6379/0
USE_REDIS=0

# Rate limiting (simple in-memory token bucket defaults)
EXECUTE_RPS_PER_IP=0.25
EXECUTE_BURST_PER_IP=2
